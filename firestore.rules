rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype data model:
    // members/{memberId}: member summary, score and status.
    // evaluations/{evaluationId}: one persisted evaluation per member/cycle.
    // PII such as email is currently present in members and therefore all
    // member reads require an authorized, verified leader or administrator.

    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isLeader() {
      return isVerifiedUser() && request.auth.token.role == 'leader';
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.role == 'admin';
    }

    function isLeaderOrAdmin() {
      return isLeader() || isAdmin();
    }

    function validId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function validTeam(team) {
      return team in [
        'Djemerson', 'Fernanda', 'Brenda', 'Alexandre', 'Alfredo',
        'Vinicius', 'Hellody', 'Samile', 'Diego'
      ];
    }

    function validStatusForScore(score, status) {
      return (score > 140 && status == 'Voando') ||
        (score > 130 && score <= 140 && status == 'Caminho Certo') ||
        (score >= 120 && score <= 130 && status == 'Atenção') ||
        (score < 120 && status == 'Alarme');
    }

    function validCriteriaScore(scores, key) {
      return !(key in scores) ||
        (scores[key] is number && scores[key] >= 0 && scores[key] <= 5);
    }

    function validCriteriaScores(scores, requireAll) {
      return scores is map &&
        scores.keys().hasOnly([
          '1-0', '1-1', '1-2', '1-3', '1-4',
          '2-0', '2-1', '2-2', '2-3', '2-4',
          '3-0', '3-1', '3-2', '3-3', '3-4',
          '4-0', '4-1', '4-2', '4-3', '4-4',
          '5-0', '5-1', '5-2', '5-3', '5-4',
          '6-0', '6-1', '6-2', '6-3', '6-4', '6-5'
        ]) &&
        (!requireAll || scores.keys().hasAll([
          '1-0', '1-1', '1-2', '1-3', '1-4',
          '2-0', '2-1', '2-2', '2-3', '2-4',
          '3-0', '3-1', '3-2', '3-3', '3-4',
          '4-0', '4-1', '4-2', '4-3', '4-4',
          '5-0', '5-1', '5-2', '5-3', '5-4',
          '6-0', '6-1', '6-2', '6-3', '6-4', '6-5'
        ])) &&
        validCriteriaScore(scores, '1-0') && validCriteriaScore(scores, '1-1') &&
        validCriteriaScore(scores, '1-2') && validCriteriaScore(scores, '1-3') &&
        validCriteriaScore(scores, '1-4') && validCriteriaScore(scores, '2-0') &&
        validCriteriaScore(scores, '2-1') && validCriteriaScore(scores, '2-2') &&
        validCriteriaScore(scores, '2-3') && validCriteriaScore(scores, '2-4') &&
        validCriteriaScore(scores, '3-0') && validCriteriaScore(scores, '3-1') &&
        validCriteriaScore(scores, '3-2') && validCriteriaScore(scores, '3-3') &&
        validCriteriaScore(scores, '3-4') && validCriteriaScore(scores, '4-0') &&
        validCriteriaScore(scores, '4-1') && validCriteriaScore(scores, '4-2') &&
        validCriteriaScore(scores, '4-3') && validCriteriaScore(scores, '4-4') &&
        validCriteriaScore(scores, '5-0') && validCriteriaScore(scores, '5-1') &&
        validCriteriaScore(scores, '5-2') && validCriteriaScore(scores, '5-3') &&
        validCriteriaScore(scores, '5-4') && validCriteriaScore(scores, '6-0') &&
        validCriteriaScore(scores, '6-1') && validCriteriaScore(scores, '6-2') &&
        validCriteriaScore(scores, '6-3') && validCriteriaScore(scores, '6-4') &&
        validCriteriaScore(scores, '6-5');
    }

    function validHistoryEntry(entry) {
      return entry is map &&
        entry.keys().hasOnly(['month', 'score']) &&
        ('month' in entry && entry.month is string && entry.month.size() > 0 && entry.month.size() <= 64) &&
        ('score' in entry && entry.score is number && entry.score >= 0 && entry.score <= 155);
    }

    function validPdiGoal(goal) {
      return goal is map &&
        goal.keys().hasOnly(['id', 'title', 'deadline', 'status', 'description', 'dueDate']) &&
        ('id' in goal && validId(goal.id)) &&
        ('title' in goal && goal.title is string && goal.title.size() > 0 && goal.title.size() <= 200) &&
        ('deadline' in goal && goal.deadline is string && goal.deadline.size() <= 100) &&
        ('status' in goal && goal.status in ['pending', 'completed']) &&
        (!('description' in goal) || (goal.description is string && goal.description.size() <= 1000)) &&
        (!('dueDate' in goal) || (goal.dueDate is string && goal.dueDate.size() <= 64));
    }

    function validMember(data, memberId) {
      return data.keys().hasOnly([
          'id', 'name', 'role', 'team', 'teamColor', 'rank', 'previousRank',
          'score', 'maxScore', 'status', 'avatarUrl', 'evaluationStatus',
          'email', 'currentRating', 'history', 'pdiGoals',
          'selfEvaluationScores', 'evaluationHistory', 'updatedAt'
        ]) &&
        data.keys().hasAll(['id', 'name', 'role', 'team', 'score', 'rank', 'maxScore', 'status', 'evaluationStatus']) &&
        data.id == memberId && validId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 120 &&
        data.team is string && data.team.size() <= 100 && validTeam(data.team) &&
        data.score is number && data.score >= 0 && data.score <= 155 &&
        data.rank is number && data.rank >= 1 && data.rank <= 10000 &&
        data.maxScore is number && data.maxScore == 155 &&
        data.status in ['Voando', 'Caminho Certo', 'Atenção', 'Alarme'] &&
        validStatusForScore(data.score, data.status) &&
        data.evaluationStatus in ['Pendente', 'Forms Respondido', 'Concluído'] &&
        (!('teamColor' in data) || (data.teamColor is string && data.teamColor.size() <= 32)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048 && (data.avatarUrl == '' || data.avatarUrl.matches('^https://.+')))) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('currentRating' in data) || (data.currentRating is number && data.currentRating >= 0 && data.currentRating <= 5)) &&
        (!('history' in data) || (data.history is list && data.history.size() <= 100 && data.history.all(validHistoryEntry))) &&
        (!('pdiGoals' in data) || (data.pdiGoals is list && data.pdiGoals.size() <= 50 && data.pdiGoals.all(validPdiGoal))) &&
        (!('selfEvaluationScores' in data) || (data.selfEvaluationScores is map && data.selfEvaluationScores.keys().size() <= 31)) &&
        (!('evaluationHistory' in data) || (data.evaluationHistory is list && data.evaluationHistory.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validLeaderEvaluationUpdate(data, memberId) {
      return validId(memberId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'score', 'status', 'evaluationStatus', 'pdiGoals', 'history', 'updatedAt'
        ]) &&
        data.score is number && data.score >= 0 && data.score <= 155 &&
        data.status in ['Voando', 'Caminho Certo', 'Atenção', 'Alarme'] &&
        validStatusForScore(data.score, data.status) &&
        data.evaluationStatus in ['Pendente', 'Forms Respondido', 'Concluído'] &&
        (!('pdiGoals' in data) || (data.pdiGoals is list && data.pdiGoals.size() <= 50 && data.pdiGoals.all(validPdiGoal))) &&
        (!('history' in data) || (data.history is list && data.history.size() <= 100 && data.history.all(validHistoryEntry))) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validEvaluation(data, evaluationId) {
      return data.keys().hasOnly([
           'id', 'memberId', 'memberName', 'leaderName', 'score', 'status',
           'cycle', 'comments', 'pdiGoals', 'criteriaScores', 'selfScores', 'revision',
           'createdAt', 'updatedAt'
         ]) &&
        data.keys().hasAll(['id', 'memberId', 'score', 'status', 'cycle', 'comments', 'criteriaScores', 'revision']) &&
        data.id == evaluationId && validId(data.id) &&
        data.memberId is string && validId(data.memberId) &&
        exists(/databases/$(database)/documents/members/$(data.memberId)) &&
        data.score is number && data.score >= 0 && data.score <= 155 &&
        data.status in ['Voando', 'Caminho Certo', 'Atenção', 'Alarme'] &&
        validStatusForScore(data.score, data.status) &&
        data.cycle is string && data.cycle.size() > 0 && data.cycle.size() <= 64 &&
        data.comments is string && data.comments.size() <= 5000 &&
        data.revision is int && data.revision >= 1 && data.revision <= 1000000 &&
        validCriteriaScores(data.criteriaScores, true) &&
        (!('memberName' in data) || (data.memberName is string && data.memberName.size() <= 100)) &&
        (!('leaderName' in data) || (data.leaderName is string && data.leaderName.size() <= 100)) &&
        (!('pdiGoals' in data) || (data.pdiGoals is list && data.pdiGoals.size() <= 50 && data.pdiGoals.all(validPdiGoal))) &&
        (!('selfScores' in data) || (data.selfScores is map && data.selfScores.keys().size() <= 31)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /members/{memberId} {
      allow read: if isLeaderOrAdmin();
      allow create: if isAdmin() && validMember(request.resource.data, memberId);
      allow update: if
        (isAdmin() && validMember(request.resource.data, memberId)) ||
        (isLeader() && validLeaderEvaluationUpdate(request.resource.data, memberId));
      allow delete: if isAdmin() && validId(memberId);
    }

    match /evaluations/{evaluationId} {
      allow read: if isLeaderOrAdmin();
      allow create: if isLeaderOrAdmin() && validEvaluation(request.resource.data, evaluationId);
      allow update: if isLeaderOrAdmin() &&
        validEvaluation(request.resource.data, evaluationId) &&
        request.resource.data.memberId == resource.data.memberId &&
        request.resource.data.cycle == resource.data.cycle &&
        (('revision' in resource.data && request.resource.data.revision == resource.data.revision + 1) ||
          (!('revision' in resource.data) && request.resource.data.revision == 1)) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin() && validId(evaluationId);
    }

    function validAuditLog(data, auditId) {
      return data.keys().hasOnly([
          'id', 'action', 'evaluationId', 'memberId', 'memberName', 'cycle',
          'revision', 'score', 'status', 'previousScore', 'previousStatus',
          'actorId', 'actorEmail', 'actorName',
          'createdAt'
        ]) &&
        data.keys().hasAll([
          'id', 'action', 'evaluationId', 'memberId', 'memberName', 'cycle',
          'revision', 'score', 'status', 'actorId', 'actorEmail', 'actorName',
          'createdAt'
        ]) &&
        data.id == auditId && validId(data.id) &&
        data.action == 'evaluation_saved' &&
        validId(data.evaluationId) && validId(data.memberId) &&
        exists(/databases/$(database)/documents/members/$(data.memberId)) &&
        data.memberName is string && data.memberName.size() <= 100 &&
        data.cycle is string && data.cycle.size() > 0 && data.cycle.size() <= 64 &&
        data.revision is int && data.revision >= 1 && data.revision <= 1000000 &&
        data.score is number && data.score >= 0 && data.score <= 155 &&
        data.status in ['Voando', 'Caminho Certo', 'Atenção', 'Alarme'] &&
        validStatusForScore(data.score, data.status) &&
        (!('previousScore' in data) || (data.previousScore is number && data.previousScore >= 0 && data.previousScore <= 155)) &&
        (!('previousStatus' in data) || data.previousStatus in ['Voando', 'Caminho Certo', 'Atenção', 'Alarme']) &&
        data.actorId is string && data.actorId.size() > 0 && data.actorId.size() <= 128 &&
        data.actorEmail is string && data.actorEmail.size() <= 254 &&
        data.actorName is string && data.actorName.size() <= 100 &&
        data.actorId == request.auth.uid &&
        data.actorEmail == request.auth.token.email &&
        data.createdAt is timestamp;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isLeaderOrAdmin() && validAuditLog(request.resource.data, auditId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
