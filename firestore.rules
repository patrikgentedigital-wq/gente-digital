rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Modelo de dados:
    // members/{memberId}: resumo do membro, score e status (PII: e-mail).
    // evaluations/{evaluationId}: uma avaliação persistida por membro/ciclo.
    // auditLogs/{auditId}: trilha imutável de auditoria.
    //
    // Arquitetura de escrita (rev. 3):
    // - Membros: criados/atualizados/excluídos (soft-delete) APENAS por admin.
    // - Avaliações, atualização de membro pelo líder e auditLogs: APENAS via
    //   Cloud Function saveEvaluation (Admin SDK + validação zod elemento a
    //   elemento — as rules não possuem list.all(), então validação de
    //   elementos de history/pdiGoals/criteriaScores é impraticável em rules).
    // - Regras detalhadas de conflito (revision) e consistência vivem na função.

    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isLeader() {
      return isVerifiedUser() && request.auth.token.role == 'leader';
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.role == 'admin';
    }

    function isLeaderOrAdmin() {
      return isLeader() || isAdmin();
    }

    function validId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function validTeam(team) {
      return team in [
        'Djemerson', 'Fernanda', 'Brenda', 'Alexandre', 'Alfredo',
        'Vinicius', 'Hellody', 'Samile', 'Diego'
      ];
    }

    function validStatusForScore(score, status) {
      return (score > 140 && status == 'Voando') ||
        (score > 130 && score <= 140 && status == 'Caminho Certo') ||
        (score >= 120 && score <= 130 && status == 'Atenção') ||
        (score < 120 && status == 'Alarme');
    }

    // NOTA: a linguagem de rules NÃO possui list.all()/any() e há o limite
    // de 1000 expressões por request. history/pdiGoals são validados aqui
    // apenas estruturalmente (lista + limite); a validação por elemento é
    // feita pelo zod na Cloud Function saveEvaluation.

    function validMember(data, memberId) {
      return data.keys().hasOnly([
          'id', 'name', 'role', 'team', 'teamColor', 'rank', 'previousRank',
          'score', 'maxScore', 'status', 'avatarUrl', 'evaluationStatus',
          'email', 'currentRating', 'history', 'pdiGoals',
          'selfEvaluationScores', 'evaluationHistory', 'updatedAt',
          'deleted', 'deletedAt', 'deletedBy'
        ]) &&
        data.keys().hasAll(['id', 'name', 'role', 'team', 'score', 'rank', 'maxScore', 'status', 'evaluationStatus']) &&
        data.id == memberId && validId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 120 &&
        data.team is string && data.team.size() <= 100 && validTeam(data.team) &&
        data.score is number && data.score >= 0 && data.score <= 155 &&
        data.rank is number && data.rank >= 1 && data.rank <= 10000 &&
        data.maxScore is number && data.maxScore == 155 &&
        data.status in ['Voando', 'Caminho Certo', 'Atenção', 'Alarme'] &&
        validStatusForScore(data.score, data.status) &&
        data.evaluationStatus in ['Pendente', 'Forms Respondido', 'Concluído'] &&
        (!('teamColor' in data) || (data.teamColor is string && data.teamColor.size() <= 32)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048 && (data.avatarUrl == '' || data.avatarUrl.matches('^https://.+')))) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('currentRating' in data) || (data.currentRating is number && data.currentRating >= 0 && data.currentRating <= 5)) &&
        (!('history' in data) || (data.history is list && data.history.size() <= 100)) &&
        (!('pdiGoals' in data) || (data.pdiGoals is list && data.pdiGoals.size() <= 50)) &&
        (!('selfEvaluationScores' in data) || (data.selfEvaluationScores is map && data.selfEvaluationScores.keys().size() <= 31)) &&
        (!('evaluationHistory' in data) || (data.evaluationHistory is list && data.evaluationHistory.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('deleted' in data) || data.deleted is bool) &&
        (!('deletedAt' in data) || data.deletedAt is timestamp) &&
        (!('deletedBy' in data) || (data.deletedBy is string && data.deletedBy.size() > 0 && data.deletedBy.size() <= 128)) &&
        (!('deleted' in data) || data.deleted != true ||
          (data.deletedAt is timestamp && data.deletedBy is string && data.deletedBy.size() > 0));
    }

    match /members/{memberId} {
      allow read: if isLeaderOrAdmin();
      allow create: if isAdmin() && validMember(request.resource.data, memberId);
      allow update: if isAdmin() && validMember(request.resource.data, memberId);
      // Exclusão definitiva não faz parte do fluxo do produto. O app usa
      // soft-delete para preservar histórico e permitir restauração.
      allow delete: if false;
    }

    match /evaluations/{evaluationId} {
      allow read: if isLeaderOrAdmin();
      // Criação/atualização apenas via Cloud Function saveEvaluation (Admin SDK).
      allow create, update: if false;
      // Avaliações só podem ser removidas por rotinas administrativas fora
      // do cliente, como o trigger de purge executado com Admin SDK.
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      // Append-only via Cloud Function saveEvaluation (Admin SDK).
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
