# Parâmetros operacionais das Cloud Functions.
BOOTSTRAP_ADMIN_EMAIL=
TEAMS_WEBHOOK_URL=

# Dias de retenção dos auditLogs. 0 mantém os registros e desativa o purge.
# Defina conforme a política LGPD aprovada pela organização.
AUDIT_LOG_RETENTION_DAYS=0

# Exige App Check na callable de salvamento após configurar a site key no frontend.
ENFORCE_APP_CHECK=false
